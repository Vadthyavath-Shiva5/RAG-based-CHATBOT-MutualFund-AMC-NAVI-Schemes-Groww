# Environment Configuration Template for RAG Chatbot
# Safe to commit: placeholders only (no real secrets).

# LLM Configuration
LLM_PROVIDER=openai  # Options: openai, anthropic, cohere
LLM_MODEL=gpt-4
LLM_API_KEY=your-llm-api-key
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000

# Embedding Model Configuration
EMBEDDING_PROVIDER=openai  # Options: openai, hf
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_BATCH_SIZE=100

# Vector Store Configuration
VECTOR_DB_TYPE=faiss  # Options: faiss, chroma, weaviate (local), pinecone
VECTOR_DB_PATH=./data/vector_store
VECTOR_DB_DIMENSION=1536

# Document Store Configuration
DOC_STORE_TYPE=sqlite  # Options: sqlite, postgres, mongodb
DOC_STORE_PATH=./data/doc_store.db
DOC_STORE_URL=sqlite:///./data/doc_store.db

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_LOG_LEVEL=INFO

# Scheduler Configuration
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC
REFRESH_SCHEDULE_CRON=0 2 * * 0  # Every Sunday at 2 AM UTC

# Data Paths
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PARSED_DATA_DIR=./data/parsed
CHUNKS_DIR=./data/chunks
MANIFESTS_DIR=./data/manifests

# Source Configuration
SOURCES_YAML_PATH=./phase0/sources.yaml
CACHE_DIR=./data/cache
CACHE_TTL_HOURS=168  # 1 week

# Safety & Compliance
PII_DETECTION_ENABLED=true
SCOPE_CLASSIFIER_ENABLED=true
POLICY_ENFORCER_ENABLED=true
MAX_PII_SCORE_THRESHOLD=0.8

# Response Configuration
MIN_CITATION_CONFIDENCE=0.85
INCLUDE_SOURCE_SNIPPETS=true
RESPONSE_LANGUAGE=en

# Logging
LOG_DIR=./logs
LOG_LEVEL=INFO
LOG_FORMAT=json  # Options: json, standard

# Monitoring & Observability
TELEMETRY_ENABLED=false
METRICS_PORT=9090
SENTRY_DSN=  # Optional: for error tracking

# Development
ENVIRONMENT=development  # Options: development, staging, production
ALLOW_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
