# ------------------------------------------------------------
# Environment profile
# ------------------------------------------------------------
ENVIRONMENT=development

# ------------------------------------------------------------
# Backend API (phase4)
# ------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# CORS: use "*" for local dev; in production set explicit origins:
# CORS_ALLOW_ORIGINS=https://your-frontend-domain.com,https://www.your-domain.com
CORS_ALLOW_ORIGINS=*

# Rate limit (/chat): keep false locally, enable in production
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=30
RATE_LIMIT_WINDOW_SECONDS=60

# ------------------------------------------------------------
# LLM and embeddings
# ------------------------------------------------------------
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-haiku-20240307
LLM_TEMPERATURE=0.3
LLM_API_KEY=your-llm-api-key
# Optional alias if provider is anthropic:
ANTHROPIC_API_KEY=

EMBEDDING_PROVIDER=hf
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Required only when embedding provider needs API key (e.g. openai)
EMBEDDING_API_KEY=

# ------------------------------------------------------------
# Paths
# ------------------------------------------------------------
DATA_DIR=./data
CACHE_DIR=./data/cache
SOURCES_YAML_PATH=./phase0/sources.yaml

# ------------------------------------------------------------
# Frontend (phase6)
# ------------------------------------------------------------
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
FRONTEND_DEBUG=false
BACKEND_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------
# Scheduler (phase5)
# ------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC
REFRESH_SCHEDULE_CRON=0 2 * * 0

# ------------------------------------------------------------
# Safety toggles
# ------------------------------------------------------------
PII_DETECTION_ENABLED=true
SCOPE_CLASSIFIER_ENABLED=true
POLICY_ENFORCER_ENABLED=true

